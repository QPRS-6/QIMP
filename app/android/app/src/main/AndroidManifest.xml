<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 纯本地播放器：需要把用户存储里的音乐目录当普通文件遍历、并解析标签与封面。
         Android 11+ 走“所有文件访问”特殊权限（设置页手动授予）；
         Android 10 及以下退回读外部存储运行时权限。
         之所以不用 SAF：核心扫描器基于 std::fs，需要真实路径而不是 content:// URI。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- 后台播放：把播放提升为前台服务，锁屏 / 息屏时不被系统回收。
         Android 14+ 必须同时声明服务类型对应的权限，否则 startForeground 直接抛异常。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 通知需要运行时权限。媒体通知即使被拒也会出现在媒体控制区，
         所以这里只声明、不强制申请，避免为了一个通知打断用户。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 播放前台服务：媒体会话 + 通知栏 / 锁屏 / 耳机按键控制。
             exported=true 是 MediaBrowserService 的惯例（车机、蓝牙要靠它找到会话）；
             服务本身不接受任何外部命令参数，所有操作都落到 Rust 引擎上。 -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- 耳机 / 蓝牙的媒体按键：系统在没有活动会话时会把这个广播发给它。 -->
        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- 桌面小部件：四个尺寸各一个接收者。
             Android 认的是「组件」（包名 + 类名），所以尺寸必须由**各自的类**区分——
             同一个类注册四次只会合成一个，系统里也就只剩一档可选。

             exported=true：APPWIDGET_UPDATE 只由系统在添加上/刷新时发给我们，
             外部应用就算发一次也只是让小部件重画一遍，没有副作用。
             另外**不能**给它们加 permission，否则系统的更新广播会被挡在外面。 -->
        <receiver
            android:name=".MusicWidget2x1"
            android:exported="true"
            android:label="@string/widget_2x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x1_info" />
        </receiver>
        <receiver
            android:name=".MusicWidget4x1"
            android:exported="true"
            android:label="@string/widget_4x1_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4x1_info" />
        </receiver>
        <receiver
            android:name=".MusicWidget2x2"
            android:exported="true"
            android:label="@string/widget_2x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_2x2_info" />
        </receiver>
        <receiver
            android:name=".MusicWidget4x2"
            android:exported="true"
            android:label="@string/widget_4x2_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_4x2_info" />
        </receiver>
        <!-- 小部件右上角齿轮点进来的设置页：改封面大小 / 按钮颜色 / 标题颜色。
             只由我们自己的 PendingIntent 拉起，所以 exported=false。
             刻意不指定主题：用平台默认的（有标题栏那套），它是**原生**页面，
             不该依赖 Flutter 的 MainActivity 主题。 -->
        <activity
            android:name=".WidgetSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/widget_settings_title" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
