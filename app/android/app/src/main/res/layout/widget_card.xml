<?xml version="1.0" encoding="utf-8"?>
<!--
  卡片式小部件（2×2 / 4×2）：
  中间上部是封面，封面下面是歌名（居中），再下面是「随机 · 上一曲 · 播放 · 下一曲 · 循环」，
  右上角一个设置齿轮。

  封面的边长由代码按「用户设的比例 × 框子尺寸」算出来，多出来的地方用 padding 吃掉
  （`setViewPadding`，见 PlaybackWidget.applyCoverSize）；XML 里的尺寸只是没算出来之前的默认样子。
  背景透明，文字与图标见 values/colors.xml。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- 封面：框子吃「剩下所有的高度」，多出来的地方用 padding 吃掉，
             于是用户设的「封面大小」就能在这个框里放大缩小，见 PlaybackWidget.applyCoverSize。 -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_cover"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_note" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            android:layout_marginStart="20dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/app_name"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_shuffle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_shuffle"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_shuffle" />

            <ImageButton
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_previous"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_previous" />

            <ImageButton
                android:id="@+id/widget_toggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_toggle"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_next"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="@string/widget_repeat"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_widget_repeat" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_settings"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:contentDescription="@string/widget_settings"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_settings" />
</FrameLayout>
